---
import MuseumLayout from '../../layouts/MuseumLayout.astro';
import { readSeasons } from '../../history/read';
const seasons = await readSeasons();
const requested = Astro.url.searchParams.get('season');
if (requested) {
  const query = new URLSearchParams({ tab: Astro.url.searchParams.get('tab') ?? 'standings', sort: Astro.url.searchParams.get('sort') ?? 'standing' });
  return Astro.redirect(`/seasons/${encodeURIComponent(requested)}/?${query}`, 302);
}
---
<MuseumLayout title="Seasons" section="Seasons">
  <div class="page-heading"><h1>Seasons</h1></div>
  {seasons.length ? <table class="history-table seasons-table">
    <caption class="visually-hidden">Season history</caption>
    <thead><tr><th scope="col">Year</th><th scope="col">Champion</th><th scope="col">Runner-up</th><th scope="col">Season format</th></tr></thead>
    <tbody>{seasons.map(season => <tr>
      <th scope="row"><a href={`/seasons/${season.year}/`}>{season.year}</a></th>
      <td data-label="Champion">—</td><td data-label="Runner-up">—</td>
      <td data-label="Season format">{season.teams.length} teams · {Number(season.settings.playoff_teams)} playoff places</td>
    </tr>)}</tbody>
  </table> : <p class="empty-history">No seasons to browse.</p>}
</MuseumLayout>
