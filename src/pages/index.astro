---
import MuseumLayout from '../layouts/MuseumLayout.astro';
import TeamImage from '../components/TeamImage.astro';
import Chevron from '../components/Chevron.astro';
import { readHome, formatRecordValue, periodLabel, recordUnit } from '../history/records';
import '../styles/home.css';
const home = await readHome();
if (!home) Astro.response.status = 503;
const featureUnit = (key: string) => key === 'best-without-title' ? 'PPG above league average' : 'points in one game';
const value = (row: { value: number }, category: { key: string; unit: string; displayPrecision?: number }) => `${category.key === 'best-without-title' && row.value > 0 ? '+' : ''}${formatRecordValue(row.value, category.displayPrecision)}${category.unit === '%' ? '%' : ''}`;
const when = (row: { period: Parameters<typeof periodLabel>[0]; detail?: string }, category: { key: string; group: string }) => category.group === 'Seasons' ? `${row.period!.year} season` : category.key === 'winning-streak' ? row.detail : periodLabel(row.period);
---
<MuseumLayout title="League record book">
  <div class="home">
    <h1 class="home-title">All-time records</h1>
    {home ? <>
      <section class="home-features" aria-label="Featured records">
        {home.features.slice(0, 2).map(feature => {
          const leader = feature.leaders[0];
          const owners = [...new Map(feature.leaders.map(row => [row.owner.id, row.owner])).values()];
          return <article class:list={['home-feature', `home-${feature.category.key}`]} data-category={feature.category.key}>
            <h2>{feature.category.name}</h2>
            {leader ? <>
              <div class="home-holders">
                {feature.leaders.length > 1 && <p class="home-shared">Shared lead · {feature.leaders.length} results</p>}
                {feature.leaders.map(row => <div>
                  <p class="home-holder">{row.name}</p>
                  {feature.category.group === 'Players' && <p class="home-owner">Benched by {row.owner.name}</p>}
                  {feature.leaders.length > 1 && <p class="home-date">{when(row, feature.category)}</p>}
                </div>)}
              </div>
              <div class="home-measure">
                <p class="home-value">{value(leader, feature.category)}</p>
                <p class="home-unit">{featureUnit(feature.category.key)}</p>
                {leader.sample && <p class="home-sample">{leader.sample}</p>}
                {feature.leaders.length === 1 && <p class="home-date">{when(leader, feature.category)}</p>}
              </div>
              <div class="home-feature-art">{owners.map(owner => <figure>
                <div class="home-artwork"><TeamImage name={owner.name} src={owner.avatar} /></div>
                <figcaption>{owner.name} · team artwork</figcaption>
              </figure>)}</div>
            </> : <p class="home-feature-empty">{feature.blocked ? 'Results unavailable for this selection.' : 'No qualifying results.'}</p>}
            <a class="home-category-link home-action" href={feature.href}>View rankings <Chevron /></a>
          </article>;
        })}
      </section>
      <section class="home-record-book" aria-labelledby="record-book-heading">
        <div class="home-section-heading"><h2 id="record-book-heading">Record book</h2><a href="/records/">All records <Chevron /></a></div>
        <table class="home-index">
          <caption class="visually-hidden">More all-time records</caption>
          <thead><tr><th scope="col">Record</th><th scope="col">Holder</th><th scope="col">Result</th><th scope="col">When</th></tr></thead>
          <tbody>{home.features.slice(2).map(feature => <tr data-category={feature.category.key}>
            <th scope="row"><a class="home-category-link" href={feature.href}>{feature.category.name}<Chevron /></a></th>
            <td class="home-index-holder">{feature.leaders.map(row => <p>{row.owner.name}{feature.category.group === 'Players' && <span> with {row.name}</span>}</p>)}{feature.leaders.length > 1 && <span class="home-shared">Shared lead · {feature.leaders.length} results</span>}</td>
            <td class="home-index-result">{feature.leaders[0] ? <><strong>{value(feature.leaders[0], feature.category)}</strong> {recordUnit(feature.category.unit, feature.leaders[0].value)}{feature.leaders[0].sample && <span class="home-sample">{feature.leaders[0].sample}</span>}</> : <span>{feature.blocked ? 'Results unavailable' : 'No qualifying results'}</span>}</td>
            <td class="home-index-date">{feature.leaders.map(row => <p>{feature.leaders.length > 1 && <>{row.owner.name} · </>}{when(row, feature.category)}</p>)}</td>
          </tr>)}</tbody>
        </table>
      </section>
      <section class="home-recent" aria-labelledby="recent-records-heading">
        <h2 id="recent-records-heading">Recent top-ten results</h2>
        {home.recent.length ? <ul>{home.recent.map(row => <li><a href={row.categoryHref}>
          <span class="home-recent-identity"><strong>{row.matchupLabel ?? row.name}<Chevron /></strong>{row.category.group === 'Players' && <span>{row.owner.name}</span>}<span>{row.category.name} · Rank {row.rank}</span></span>
          <span class="home-recent-result"><strong>{value(row, row.category)}</strong> {row.category.unit === '%' ? row.category.valueLabel ?? '%' : recordUnit(row.category.unit, row.value)}{row.sample && <span class="home-sample">{row.sample}</span>}</span>
          <span class="home-recent-date">{when(row, row.category)}</span>
        </a></li>)}</ul> : <p class="empty-history">No qualifying recent results.</p>}
      </section>
    </> : <p class="empty-history">League history is unavailable.</p>}
  </div>
</MuseumLayout>
