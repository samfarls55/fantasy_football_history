---
import Base from '../layouts/Base.astro';
import Lookup from '../components/Lookup.astro';
import { findLeagues } from '../leagues.ts';

const username = Astro.url.searchParams.get('u')?.trim() ?? '';
const lookup = username ? await findLeagues(username) : undefined;
const leagues = lookup?.leagues;
// You arrive in a league already marked: your name is painted everywhere you appear. With one league you go straight to it;
// the way back from it asks for the list, so it doesn't send you straight in again.
const arrive = (id: string) => `/leagues/${id}?${new URLSearchParams({ u: lookup!.name })}`;
if (leagues?.length === 1 && !Astro.url.searchParams.has('list')) return Astro.redirect(arrive(leagues[0].id));
---
<Base title="League history" full>
  <Fragment slot="endzone">
    <Lookup username={username} autofocus />
    {lookup === null && <p class="notice">No Sleeper user is named {username}. Check the spelling and try again.</p>}
    {leagues?.length === 0 && <p class="notice">{username} isn’t in any leagues this season or last.</p>}
    {leagues && leagues.length > 0 && (
      <ul class="leagues">
        {leagues.map((league, index) => (
          <li style={`--i: ${index}`}>
            <a href={arrive(league.id)}>
              {league.avatar ? <img src={league.avatar} alt="" width="52" height="52" /> : <span class="avatar-blank" />}
              <span class="league-title">{league.name}</span>
              <span class="league-meta">{league.teams} teams</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Fragment>
</Base>
