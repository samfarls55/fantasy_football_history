---
import Base from '../layouts/Base.astro';
import { findLeagues } from '../leagues.ts';

const username = Astro.url.searchParams.get('u')?.trim() ?? '';
const leagues = username ? await findLeagues(username) : undefined;
if (leagues?.length === 1) return Astro.redirect(`/leagues/${leagues[0].id}`);
---
<Base title="League history" full>
  <Fragment slot="endzone">
    <form class="lookup" method="get" action="/">
      <h1 class="painted">Find your league</h1>
      <div class="lookup-row">
        <input name="u" value={username} placeholder="Sleeper username" aria-label="Sleeper username" autocomplete="username" required autofocus />
        <button>Find leagues</button>
      </div>
    </form>
    {leagues === null && <p class="notice">No Sleeper user is named {username}. Check the spelling and try again.</p>}
    {leagues?.length === 0 && <p class="notice">{username} isn’t in any leagues this season or last.</p>}
    {leagues && leagues.length > 1 && (
      <ul class="leagues">
        {leagues.map((league, index) => (
          <li style={`--i: ${index}`}>
            <a href={`/leagues/${league.id}?u=${encodeURIComponent(username)}`}>
              {league.avatar ? <img src={league.avatar} alt="" width="52" height="52" /> : <span class="avatar-blank" />}
              <span class="league-title">{league.name}</span>
              <span class="league-meta">{league.teams} teams</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Fragment>
</Base>
