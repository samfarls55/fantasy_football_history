---
import Tab from '../../../layouts/Tab.astro';
import Records from '../../../components/Records.astro';
import ScheduleSwap from '../../../components/ScheduleSwap.astro';
import Section from '../../../components/Section.astro';
import Stats from '../../../components/Stats.astro';
import { openTab } from '../../../league-page.ts';
import { readScheduleSwap } from '../../../history/schedule-swap.ts';

const { redirect, frame, view } = await openTab(Astro, 'excuses', async storePath => ({
  swap: await readScheduleSwap({ storePath, season: Astro.url.searchParams.get('season') ?? undefined }),
}));
if (redirect) return redirect;
const halves = ([['luck', 'Luck'], ['lineups', 'Lineups']] as const).filter(([place]) => frame.tab?.places.includes(place));
---
<Tab {...frame}>
  <nav slot="endzone" class="halves" aria-label="Excuses">{halves.map(([place, title]) => <a href={`#${place}`}>{title}</a>)}</nav>
  {halves.map(([place, title]) => (
    <Section id={place} title={title}>
      <Records views={view!.records.filter(record => record.category.place === place)} heading="h3" />
      <Stats labelledby={`${place}-name`} stats={view!.stats.filter(stat => stat.place === place)} />
      {place === 'luck' && <ScheduleSwap swap={view!.swap} />}
    </Section>
  ))}
</Tab>
