---
import Tab from '../../../layouts/Tab.astro';
import Records from '../../../components/Records.astro';
import Section from '../../../components/Section.astro';
import { openTab } from '../../../league-page.ts';

const { redirect, frame, view } = await openTab(Astro, 'excuses');
if (redirect) return redirect;
const halves = ([['luck', 'Luck'], ['lineups', 'Lineups']] as const).filter(([place]) => frame.tab?.places.includes(place));
---
<Tab {...frame}>
  <nav slot="endzone" class="halves" aria-label="Excuses">{halves.map(([place, title]) => <a href={`#${place}`}>{title}</a>)}</nav>
  {halves.map(([place, title]) => (
    <Section id={place} title={title}>
      <Records views={view!.records.filter(record => record.category.place === place)} heading="h3" />
    </Section>
  ))}
</Tab>
