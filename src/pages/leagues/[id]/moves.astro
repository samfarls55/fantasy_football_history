---
import Tab from '../../../layouts/Tab.astro';
import Records from '../../../components/Records.astro';
import TradeMap from '../../../components/TradeMap.astro';
import { openTab } from '../../../league-page.ts';
import { readTradeMap } from '../../../history/trades.ts';

const { redirect, frame, view } = await openTab(Astro, 'moves', async storePath => ({
  trades: (await readTradeMap({ storePath }))!,
}));
if (redirect) return redirect;
---
<Tab {...frame}>
  {view && (
    <>
      <Records views={view.records} heading="h2" />
      <TradeMap map={view.trades} />
    </>
  )}
</Tab>
