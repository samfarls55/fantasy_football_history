---
import Tab from '../../../layouts/Tab.astro';
import Belt from '../../../components/Belt.astro';
import HeadToHead from '../../../components/HeadToHead.astro';
import Records from '../../../components/Records.astro';
import Section from '../../../components/Section.astro';
import Stats from '../../../components/Stats.astro';
import { openTab } from '../../../league-page.ts';
import { readBelt } from '../../../history/belt.ts';
import { readHeadToHead, readRivalryStreaks } from '../../../history/rivalries.ts';

const { redirect, frame, view } = await openTab(Astro, 'legacy', async storePath => ({
  belt: (await readBelt({ storePath }))!,
  headToHead: await readHeadToHead({ storePath }),
  streaks: (await readRivalryStreaks({ storePath }))!,
}));
if (redirect) return redirect;
---
<Tab {...frame}>
  {view && (
    <>
      <Section id="careers" title="Careers"><Stats labelledby="careers-name" stats={view.stats} by={['titles', 'win-rate']} /></Section>
      <Records views={view.records} heading="h2" />
      <Belt belt={view.belt} />
      <HeadToHead rows={view.headToHead} streaks={view.streaks} />
    </>
  )}
</Tab>
