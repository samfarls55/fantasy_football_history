---
import League from '../../layouts/League.astro';
import BeltHolder from '../../components/BeltHolder.astro';
import Champions from '../../components/Champions.astro';
import Manager from '../../components/Manager.astro';
import Managers from '../../components/Managers.astro';
import Miss from '../../components/Miss.astro';
import RecordCard from '../../components/RecordCard.astro';
import ShareLink from '../../components/ShareLink.astro';
import { leagueHref, managerHref, openTab } from '../../league-page.ts';
import { readBadges } from '../../history/badges.ts';
import { readBelt } from '../../history/belt.ts';
import { readSeasons } from '../../history/read.ts';
import { readManagers } from '../../history/managers.ts';
import { readManagerName } from '../../history/manager-names.ts';

// Links shared while a manager was a highlight on this page name them in ?manager=, with any open head-to-head in ?vs=.
const markParam = Astro.url.searchParams.get('manager');
const vsParam = Astro.url.searchParams.get('vs');

const { frame, view } = await openTab(Astro, 'home', async storePath => {
  const seasons = (await readSeasons(storePath))!;
  const managers = (await readManagers({ storePath }))!;
  const nameOf = new Map(managers.map(manager => [manager.id, manager.name]));
  const named = markParam ? (await readManagerName(markParam, { storePath }))! : null;
  const plates = seasons.toReversed().map(season => ({
    year: season.year, complete: season.complete,
    champions: season.teams.filter(team => team.finish === 1).map(team => nameOf.get(team.personId) ?? team.name),
  }));
  // The field ends in the other end zone, painted with the last season that finished.
  const lastDone = seasons.find(season => season.complete);
  const winners = lastDone?.teams.filter(team => team.finish === 1) ?? [];
  const reigning = winners.length ? { year: lastDone!.year, champions: winners.map(team => nameOf.get(team.personId) ?? team.name),
    titles: winners.length === 1 ? managers.find(manager => manager.id === winners[0].personId)!.facts.championships : 0 } : null;
  return { first: seasons.at(-1)!.year, last: seasons[0].year, plates, reigning, managers, badges: (await readBadges({ storePath }))!, belt: (await readBelt({ storePath }))!,
    manager: named?.id ? nameOf.get(named.id)! : null, missed: named && !named.id ? { name: markParam!, suggestion: named.suggestion } : null };
});
// The browser carries the fragment along, so #vs and #rivalries land on the manager's page too.
if (view?.manager) return Astro.redirect(managerHref(Astro, view.manager, vsParam ? { vs: vsParam } : {}));
---
<League title={`${view?.league} history`} failure={frame.failure} tabs={frame.tabs} tab={frame.tab}>
  <Fragment slot="endzone">
    {view && (
      <>
        <h1 class="painted league-name">{view.league}<ShareLink label={`Share ${view.league}`} /></h1>
        <p class="league-years">{view.first === view.last ? view.first : `${view.first}–${view.last}`}</p>
        {view.missed && <Miss {...view.missed} href={name => managerHref(Astro, name, vsParam ? { vs: vsParam } : {})} clear={leagueHref(Astro)} />}
      </>
    )}
  </Fragment>

  {view && (
    <>
      <Champions plates={view.plates} />
      <BeltHolder belt={view.belt} />
      {/* The headline: the best team that went home empty is the record every league argues about. */}
      {view.records.map(record => <ul class="plays" id="records"><RecordCard view={record} heading="h2" index={0} headline wide /></ul>)}
      <Managers managers={view.managers} badges={view.badges} tabs={frame.tabs} />
    </>
  )}
  {view?.reigning && (
    <footer slot="close" class="endzone close">
      <div class="endzone-inner">
        <p class="painted close-name">{view.reigning.champions.map((champion, index) => <>{index > 0 && ' & '}<Manager name={champion} /></>)}</p>
        <p class="league-years">{view.reigning.year} champion{view.reigning.titles > 1 && ` · ${view.reigning.titles} titles`}</p>
      </div>
    </footer>
  )}
</League>
