---
import Base from '../../layouts/Base.astro';
import { ensureLeague, leagueStorePath } from '../../leagues.ts';
import { withHistorySnapshot } from '../../history/store.ts';
import { readSeasons } from '../../history/read.ts';
import { readManagers } from '../../history/managers.ts';
import { readCategory, formatRecordValue } from '../../history/records.ts';
import { readRivalry } from '../../history/rivalries.ts';

const { id = '' } = Astro.params;
if (!/^\d+$/.test(id)) return new Response(null, { status: 404 });
const username = Astro.url.searchParams.get('u')?.trim();
const back = username ? { href: `/?u=${encodeURIComponent(username)}`, label: `${username}’s leagues` } : undefined;
let failure: string | null = null;
try {
  await ensureLeague(id);
} catch (error) {
  console.error(`League ${id} import failed`, error);
  failure = 'Sleeper didn’t return this league’s history. Check the league link, or pick the league again from your username.';
}

interface Feature { key: string; name: string; unit: string; shame?: boolean; verb?: string }
// The headline: the best team that went home empty is the record every league argues about.
const headlineFeature: Feature = { key: 'best-without-title', name: 'Best season without a title', unit: 'more points per game than the league average', shame: true };
// Opposites face each other across the field: fame in white paint, shame under a flag.
const pairFeatures: Feature[][] = [
  [{ key: 'highest-score', name: 'Highest score', unit: 'points' }, { key: 'lowest-score', name: 'Lowest score', unit: 'points', shame: true }],
  [{ key: 'winning-streak', name: 'Longest winning streak', unit: 'wins in a row' }, { key: 'losing-streak', name: 'Longest losing streak', unit: 'losses in a row', shame: true }],
  [{ key: 'biggest-blowout', name: 'Biggest blowout', unit: 'point margin' }, { key: 'closest-game', name: 'Closest game', unit: 'point margin' }],
  [{ key: 'productive-pickup', name: 'Best pickup', unit: 'points as a starter', verb: 'picked up' }, { key: 'productive-drop', name: 'Worst drop', unit: 'points for other teams', verb: 'dropped', shame: true }],
  [{ key: 'unluckiest-season', name: 'Unluckiest season', unit: 'fewer wins than their points earned', shame: true }, { key: 'benched-player', name: 'Most points left on the bench', unit: 'points', verb: 'benched', shame: true }],
];

const storePath = leagueStorePath(id);
const history = failure ? null : await withHistorySnapshot(async () => {
  const seasons = (await readSeasons(storePath))!;
  const managers = (await readManagers({ storePath }))!;
  const nameOf = new Map(managers.map(manager => [manager.id, manager.name]));
  const plates = seasons.toReversed().map(season => ({
    year: season.year, complete: season.complete,
    champion: season.teams.filter(team => team.finish === 1).map(team => nameOf.get(team.personId) ?? team.name).join(' & '),
  }));
  const load = async (feature: Feature) => {
    const view = await readCategory(feature.key, { storePath });
    if (!view || view.blocked || !view.rows.length) return null;
    return { feature, percent: view.category.unit === '%', precision: view.category.displayPrecision ?? 2,
      rows: view.rows.filter(row => row.rank <= 3).slice(0, 3).map(row => ({ ...row, manager: nameOf.get(row.personId)! })) };
  };
  const headline = await load(headlineFeature);
  const pairs = (await Promise.all(pairFeatures.map(pair => Promise.all(pair.map(load)))))
    .map(pair => pair.filter(record => record !== null)).filter(pair => pair.length);
  const careers = managers.toSorted((a, b) => b.facts.championships - a.facts.championships || (b.facts.winPercentage ?? -1) - (a.facts.winPercentage ?? -1) || a.name.localeCompare(b.name));
  const streaks = [];
  const current = managers.filter(manager => manager.current);
  for (const [index, a] of current.entries()) for (const b of current.slice(index + 1)) {
    const rivalry = await readRivalry(a.id, b.id, { storePath, scope: 'combined' });
    if (!rivalry?.streak || rivalry.streak.result !== 'W' && rivalry.streak.result !== 'L' || rivalry.streak.count < 3) continue;
    const winnerIsA = rivalry.streak.person.id === a.id;
    streaks.push({ winner: rivalry.streak.person.name, loser: winnerIsA ? b.name : a.name, count: rivalry.streak.count,
      record: winnerIsA ? `${rivalry.wins}–${rivalry.losses}` : `${rivalry.losses}–${rivalry.wins}` });
  }
  streaks.sort((a, b) => b.count - a.count || a.winner.localeCompare(b.winner));
  return { name: seasons[0].name, first: seasons.at(-1)!.year, last: seasons[0].year, plates, headline, pairs, careers, streaks: streaks.slice(0, 5) };
}, storePath);

type Row = { value: number; name: string; manager: string; leaderContext?: string; secondary?: { name: string }[]; matchupLabel?: string };
const value = (record: { percent: boolean; precision: number }, row: Row) =>
  record.percent ? `${row.value > 0 ? '+' : ''}${formatRecordValue(row.value, 1)}%` : formatRecordValue(row.value, record.precision);
const who = (feature: Feature, row: Row) => feature.verb ? `${row.manager} ${feature.verb} ${row.name}`
  : row.matchupLabel && row.secondary?.[0] ? `${row.name} over ${row.secondary[0].name}` : row.name;
// Player records lead their context with the manager, already named in who().
const when = (feature: Feature, row: Row) => (feature.verb ? row.leaderContext?.split(' · ').slice(1).join(', ').replace(/ (pickup|drop)$/, '') : row.leaderContext?.replaceAll(' · ', ', ')) ?? '';
---
<Base title={history ? `${history.name} history` : 'League history'} back={back}>
  <Fragment slot="endzone">
    {failure && <p class="notice">{failure}</p>}
    {history && (
      <>
        <h1 class="painted league-name">{history.name}</h1>
        <p class="league-years">{history.first}–{history.last}</p>
      </>
    )}
  </Fragment>

  {history && (
    <>
      <nav class="jump" aria-label="Sections">
        <a href="#champions"><span aria-hidden="true">10</span>Champions</a>
        <a href="#records"><span aria-hidden="true">20</span>Records</a>
        <a href="#careers"><span aria-hidden="true">30</span>Careers</a>
        {history.streaks.length > 0 && <a href="#streaks"><span aria-hidden="true">40</span>Streaks</a>}
      </nav>

      <section class="block" id="champions">
        <h2 class="painted" data-yard="10">Champions</h2>
        <ol class="drive">
          {history.plates.map((plate, index) => (
            <li class="yard" style={`--i: ${index}`}>
              <span class="yard-year">{plate.year}</span>
              {plate.complete
                ? <span class="yard-champ">{plate.champion || '—'}</span>
                : <span class="yard-live"><span class="ball" aria-hidden="true" />In play</span>}
            </li>
          ))}
        </ol>
      </section>

      <section class="block" id="records">
        <h2 class="painted" data-yard="20">Hall of fame <span class="shame-word">&amp; shame</span></h2>
        <ul class="plays">
          {[...(history.headline ? [[history.headline]] : []), ...history.pairs].flatMap((pair, pairIndex) => pair.map((record, side) => {
            const leaders = record.rows.filter(row => row.rank === 1);
            const others = record.rows.filter(row => row.rank !== 1);
            return (
              <li id={record.feature.key} class:list={['play', { shame: record.feature.shame, headline: record === history.headline, wide: pair.length === 1, across: side > 0 }]} style={`--i: ${pairIndex}`}>
                {record.feature.shame && (
                  <svg class="flag" viewBox="0 0 56 46" aria-hidden="true">
                    <path class="flag-cloth" d="M13 11c9-6 20-3 30-6 4-1 8 0 10 2l-3 26c-8 4-17 1-25 4-5 2-10 3-14 1z" />
                    <path class="flag-fold" d="M30 7c-2 9-1 19 1 29" />
                    <circle class="flag-knot" cx="11" cy="11" r="7" />
                  </svg>
                )}
                <h3>{record.feature.name}<a class="share" href={`#${record.feature.key}`} aria-label={`Share ${record.feature.name}`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8.5 11.5l3-3M7 9.5l-2 2a2.8 2.8 0 004 4l2-2M13 10.5l2-2a2.8 2.8 0 00-4-4l-2 2" /></svg></a></h3>
                <p class="play-figure"><span class="play-value">{value(record, leaders[0])}</span><span class="play-unit">{record.feature.unit}</span></p>
                {leaders.map(row => <p class="play-holder"><strong>{who(record.feature, row)}</strong><span>{when(record.feature, row)}</span></p>)}
                {others.length > 0 && (
                  <details class="play-next">
                    <summary>{[...new Set(others.map(row => row.rank))].map(rank => ['', '1st', '2nd', '3rd'][rank]).join(' & ')}</summary>
                    <ol>
                      {others.map(row => <li value={row.rank}><span>{who(record.feature, row)}</span><span>{value(record, row)}</span></li>)}
                    </ol>
                  </details>
                )}
              </li>
            );
          }))}
        </ul>
      </section>

      <section class="block" id="careers">
        <h2 class="painted" data-yard="30">Careers</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Manager</th><th scope="col">Seasons</th><th scope="col">Record</th><th scope="col">Win %</th><th scope="col">Points</th><th scope="col">Playoffs</th><th scope="col">Titles</th></tr></thead>
            <tbody>
              {history.careers.map(manager => (
                <tr class:list={{ former: !manager.current }}>
                  <th scope="row">{manager.name}</th>
                  <td>{manager.range}</td>
                  <td>{manager.facts.record}{manager.facts.ties ? `–${manager.facts.ties}` : ''}</td>
                  <td>{manager.facts.winPercentage === null ? '—' : formatRecordValue(manager.facts.winPercentage, 1)}</td>
                  <td>{formatRecordValue(manager.facts.points, 0)}</td>
                  <td>{manager.facts.playoffAppearances}</td>
                  <td class:list={['titles', { won: manager.facts.championships > 0 }]}>{manager.facts.championships}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {history.streaks.length > 0 && (
        <section class="block" id="streaks">
          <h2 class="painted" data-yard="40">Head-to-head streaks</h2>
          <ul class="streaks">
            {history.streaks.map(streak => (
              <li>
                <span class="streak-count">{streak.count}</span>
                <p><strong>{streak.winner}</strong> has beaten <strong>{streak.loser}</strong> {streak.count} straight. {streak.record} including playoffs.</p>
              </li>
            ))}
          </ul>
        </section>
      )}
      <p class="copied" role="status"></p>
    </>
  )}
</Base>

<script>
  // Without JS the share link is a plain anchor; with it, phones get the share sheet and desktops copy the link.
  let timer = 0;
  document.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.share');
    if (!link) return;
    const url = `${location.origin}${location.pathname}${link.hash}`;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      event.preventDefault();
      navigator.share({ title: `${link.closest('h3')!.textContent} · ${document.title}`, url }).catch(() => {});
    } else if (navigator.clipboard) {
      event.preventDefault();
      history.replaceState(null, '', link.hash);
      navigator.clipboard.writeText(url).then(() => {
        const status = document.querySelector('.copied')!;
        status.textContent = 'Link copied';
        clearTimeout(timer);
        timer = window.setTimeout(() => { status.textContent = ''; }, 1800);
      });
    }
  });
</script>
