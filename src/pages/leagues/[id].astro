---
import Base from '../../layouts/Base.astro';
import Lookup from '../../components/Lookup.astro';
import { ensureLeague, leagueStorePath } from '../../leagues.ts';
import { withHistorySnapshot } from '../../history/store.ts';
import { readSeasons } from '../../history/read.ts';
import { readManagers } from '../../history/managers.ts';
import { readCategory } from '../../history/records.ts';
import { readManagerRivalries, readRivalry } from '../../history/rivalries.ts';

const { id = '' } = Astro.params;
const username = Astro.url.searchParams.get('u')?.trim() ?? '';
const markParam = Astro.url.searchParams.get('manager');
const status = /^\d+$/.test(id) ? await ensureLeague(id) : 'missing';
// A league that can't be shown says why, with the username lookup right there to pick it again.
const failure = { ready: null, missing: `Sleeper has no league with ID ${id}.`, failed: 'Sleeper didn’t send this league’s history. Try again in a minute.' }[status];
if (failure) Astro.response.status = status === 'missing' ? 404 : 502;
const back = failure ? undefined : username ? { href: `/?u=${encodeURIComponent(username)}`, label: `${username}’s leagues` } : { href: '/', label: 'Find your league' };

// digits: one fixed precision per record so a figure and its runners-up line up (points 2, percentages 1, counts 0).
interface Feature { key: string; name: string; unit: string; digits: number; shame?: boolean; verb?: string }
// The headline: the best team that went home empty is the record every league argues about.
const headlineFeature: Feature = { key: 'best-without-title', name: 'Best season without a title', unit: 'above the league’s average weekly score', digits: 1, shame: true };
// Opposites face each other across the field: fame in white paint, shame under a flag. Pairs sit in themed groups so the run has structure.
const groupFeatures: { name: string; pairs: Feature[][] }[] = [
  { name: 'Scoring', pairs: [
    [{ key: 'highest-score', name: 'Highest score', unit: 'points', digits: 2 }, { key: 'lowest-score', name: 'Lowest score', unit: 'points', digits: 2, shame: true }],
    [{ key: 'biggest-blowout', name: 'Biggest blowout', unit: 'point margin', digits: 2 }, { key: 'closest-game', name: 'Closest game', unit: 'point margin', digits: 2 }],
  ] },
  { name: 'Streaks', pairs: [
    [{ key: 'winning-streak', name: 'Longest winning streak', unit: 'wins in a row', digits: 0 }, { key: 'losing-streak', name: 'Longest losing streak', unit: 'losses in a row', digits: 0, shame: true }],
  ] },
  { name: 'Roster & luck', pairs: [
    [{ key: 'productive-pickup', name: 'Best pickup', unit: 'points as a starter', digits: 2, verb: 'picked up' }, { key: 'productive-drop', name: 'Worst drop', unit: 'points for other teams', digits: 2, verb: 'dropped', shame: true }],
    [{ key: 'unluckiest-season', name: 'Unluckiest season', unit: 'wins short of what their points deserved', digits: 1, shame: true }, { key: 'benched-player', name: 'Most points left on the bench', unit: 'points', digits: 2, verb: 'benched', shame: true }],
  ] },
];

const storePath = leagueStorePath(id);
const history = failure ? null : await withHistorySnapshot(async () => {
  const seasons = (await readSeasons(storePath))!;
  const managers = (await readManagers({ storePath }))!;
  const nameOf = new Map(managers.map(manager => [manager.id, manager.name]));
  const plates = seasons.toReversed().map(season => ({
    year: season.year, complete: season.complete,
    champions: season.teams.filter(team => team.finish === 1).map(team => nameOf.get(team.personId) ?? team.name),
  }));
  const load = async (feature: Feature) => {
    const view = await readCategory(feature.key, { storePath });
    if (!view || view.blocked || !view.rows.length) return null;
    return { feature, percent: view.category.unit === '%',
      // Ties share a rank, so every row ranked third or better shows; none drops silently.
      // A matchup row names its loser only through a link to their page, which carries their person id.
      rows: view.rows.filter(row => row.rank <= 3).map(row => ({ ...row, manager: nameOf.get(row.personId)!,
        opponent: row.matchupLabel && row.secondary ? nameOf.get(row.secondary[0].href.split('/')[2]) : undefined })) };
  };
  const headline = await load(headlineFeature);
  // The headline stands alone in an unnamed first group; a pair missing one side spans the row.
  const named = await Promise.all(groupFeatures.map(async group => ({ name: group.name,
    rows: (await Promise.all(group.pairs.map(pair => Promise.all(pair.map(load))))).map(pair => pair.filter(record => record !== null)).filter(pair => pair.length) })));
  const groups = [...(headline ? [{ name: '', rows: [[headline]] }] : []), ...named.filter(group => group.rows.length)];
  const careers = managers.toSorted((a, b) => b.facts.championships - a.facts.championships || (b.facts.winPercentage ?? -1) - (a.facts.winPercentage ?? -1) || a.name.localeCompare(b.name));
  const streaks = [];
  const current = managers.filter(manager => manager.current);
  for (const [index, a] of current.entries()) for (const b of current.slice(index + 1)) {
    const rivalry = await readRivalry(a.id, b.id, { storePath, scope: 'combined' });
    if (!rivalry?.streak || rivalry.streak.result !== 'W' && rivalry.streak.result !== 'L' || rivalry.streak.count < 3) continue;
    const winnerIsA = rivalry.streak.person.id === a.id;
    streaks.push({ winner: rivalry.streak.person.name, loser: winnerIsA ? b.name : a.name, count: rivalry.streak.count,
      record: winnerIsA ? `${rivalry.wins}–${rivalry.losses}` : `${rivalry.losses}–${rivalry.wins}` });
  }
  streaks.sort((a, b) => b.count - a.count || a.winner.localeCompare(b.winner));
  // ?manager=<username> highlights one manager everywhere they appear, readable in a group chat; an unknown name highlights no one.
  const marked = managers.find(manager => manager.name === markParam) ?? null;
  // A highlighted manager's rivalries become their record against everyone they've played, counted like the streaks.
  // Most-played leads, since that's where a record settles anything; among equals the most lopsided goes first. Former managers trail.
  const currentIds = new Set(current.map(manager => manager.id));
  const versus = marked ? (await readManagerRivalries(marked.id, { storePath, scope: 'combined' }))!.rows
    .map(row => ({ name: row.b.name, current: currentIds.has(row.b.id), record: row.record, edge: row.wins - row.losses, meetings: row.meetings,
      streak: row.streak && `${row.streak.result}${row.streak.count}` }))
    .sort((a, b) => Number(b.current) - Number(a.current) || b.meetings - a.meetings || Math.abs(b.edge) - Math.abs(a.edge) || a.name.localeCompare(b.name)) : [];
  // The field ends in the other end zone, painted with the last season that finished.
  const lastDone = seasons.find(season => season.complete);
  const winners = lastDone?.teams.filter(team => team.finish === 1) ?? [];
  const reigning = winners.length ? { year: lastDone!.year, champions: winners.map(team => nameOf.get(team.personId) ?? team.name),
    titles: winners.length === 1 ? managers.find(manager => manager.id === winners[0].personId)!.facts.championships : 0 } : null;
  return { name: seasons[0].name, first: seasons.at(-1)!.year, last: seasons[0].year, plates, headline, groups, careers, streaks: streaks.slice(0, 5), versus, reigning, marked };
}, storePath);
// A manager's name links to the page with them highlighted, or back to no one when they already are. ?u= rides along.
const markHref = (name: string | null) => {
  const query = new URLSearchParams({ ...(username && { u: username }), ...(name && name !== history?.marked?.name && { manager: name }) }).toString();
  return query ? `?${query}` : Astro.url.pathname;
};
const mine = (name: string) => name === history?.marked?.name;
// Every manager name on the page is this one link, so each takes the highlight the same way.
const person = (name: string) => ({ href: markHref(name), 'data-person': name, class: mine(name) ? 'me' : undefined, 'aria-current': mine(name) ? 'true' as const : undefined });

type Row = { value: number; name: string; manager: string; opponent?: string; leaderContext?: string };
const fixed = (number: number, digits: number) => number.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
const value = (record: { feature: Feature; percent: boolean }, row: Row) =>
  record.percent ? `${fixed(row.value, record.feature.digits)}%` : fixed(row.value, record.feature.digits);
// Who holds a record, as text and the managers in it, so each manager's own name takes the highlight.
const who = (feature: Feature, row: Row): (string | { person: string })[] => feature.verb ? [{ person: row.manager }, ` ${feature.verb} ${row.name}`]
  : row.opponent ? [{ person: row.manager }, ' beat ', { person: row.opponent }] : [{ person: row.manager }];
const involves = (row: Row) => mine(row.manager) || !!row.opponent && mine(row.opponent);
// Every context reads "Week 3, 2020" (a streak "Weeks 1–12, 2023"), and a date never breaks across lines. Player records lead it with the manager, already named in who().
const when = (feature: Feature, row: Row) => (row.leaderContext ?? '').split(' · ').slice(feature.verb ? 1 : 0).join(', ').replace(/Week (\d+), (\d{4}) – Week (\d+), \2/,'Weeks $1–$3, $2').replace(/Week (\d+), (\d{4})/g, 'Week $1, $2');
// Each thrown flag lands its own way: tilt, mirror and a nudge, fixed per record so reloads match.
const landing = (key: string) => {
  const hash = [...key].reduce((sum, char) => (sum * 31 + char.charCodeAt(0)) >>> 0, 7);
  return `--tilt: ${hash % 27 - 15}deg; --flip: ${hash >> 4 & 1 ? -1 : 1}; --dx: ${-(hash >> 5) % 10}px; --dy: ${(hash >> 9) % 9 - 3}px`;
};
---
<Base title={history ? `${history.name} history` : status === 'missing' ? 'League not found' : 'League history'} back={back} full={!history}>
  <Fragment slot="endzone">
    {failure && (
      <>
        <p class="notice lead">{failure}</p>
        <Lookup username={username} />
      </>
    )}
    {history && (
      <>
        <h1 class="painted league-name">{history.name}</h1>
        <p class="league-years">{history.first === history.last ? history.first : `${history.first}–${history.last}`}</p>
        <p class="marking" hidden={!history.marked}>
          <span class="unseen">Highlighting </span><span class="me marking-name">{history.marked?.name}</span>
          <a href={markHref(null)}>Clear</a>
        </p>
      </>
    )}
  </Fragment>

  {history && (
    <>
      <nav class="jump" aria-label="Sections">
        <a href="#champions"><span aria-hidden="true">10</span>Champions</a>
        {history.groups.length > 0 && <a href="#records"><span aria-hidden="true">20</span>Fame &amp; shame</a>}
        <a href="#careers"><span aria-hidden="true">30</span>Careers</a>
        {(history.streaks.length > 0 || history.versus.length > 0) && <a href="#rivalries"><span aria-hidden="true">40</span>Rivalries</a>}
      </nav>

      <section class="block" id="champions">
        <h2 class="painted" data-yard="10">Champions</h2>
        {/* The seasons' stagger shares a fixed span, so a long history loads as fast as a short one. */}
        <ol class="drive" style={`--step: ${Math.min(90, Math.round(360 / Math.max(1, history.plates.length - 1)))}ms`}>
          {history.plates.map((plate, index) => (
            <li class="yard" style={`--i: ${index}`}>
              <span class="yard-year">{plate.year}</span>
              {plate.complete
                ? <span class="yard-champ">{plate.champions.length ? plate.champions.map((champion, index) => <>{index > 0 && ' & '}<a {...person(champion)}>{champion}</a></>) : '—'}</span>
                : <span class="yard-live"><span class="ball" aria-hidden="true" />In play</span>}
            </li>
          ))}
        </ol>
      </section>

      {history.groups.length > 0 && (
      <section class="block" id="records">
        <h2 class="painted" data-yard="20">Fame <span class="shame-word">&amp; shame</span></h2>
        {history.groups.map(group => (
        <>
        {group.name && <h3 class="group-name">{group.name}</h3>}
        <ul class="plays">
          {group.rows.flatMap((pair, pairIndex) => pair.map((record, side) => {
            const leaders = record.rows.filter(row => row.rank === 1);
            const others = record.rows.filter(row => row.rank !== 1);
            const Title = group.name ? 'h4' : 'h3';
            return (
              <li id={record.feature.key} class:list={['play', { shame: record.feature.shame, headline: record === history.headline, wide: pair.length === 1, across: side > 0 }]} style={`--i: ${pairIndex}; ${landing(record.feature.key)}`}>
                {record.feature.shame && (
                  <svg class="flag" viewBox="0 0 56 46" aria-hidden="true">
                    <path class="flag-cloth" d="M13 11c9-6 20-3 30-6 4-1 8 0 10 2l-3 26c-8 4-17 1-25 4-5 2-10 3-14 1z" />
                    <path class="flag-fold" d="M30 7c-2 9-1 19 1 29" />
                    <circle class="flag-knot" cx="11" cy="11" r="7" />
                  </svg>
                )}
                <Title class="play-title"><span class="unseen">{record.feature.shame ? 'Shame: ' : 'Fame: '}</span>{record.feature.name}<a class="share" href={`#${record.feature.key}`} aria-label={`Share ${record.feature.name}`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8.5 11.5l3-3M7 9.5l-2 2a2.8 2.8 0 004 4l2-2M13 10.5l2-2a2.8 2.8 0 00-4-4l-2 2" /></svg></a></Title>
                <p class="play-figure"><span class="play-value">{value(record, leaders[0])}</span><span class="play-unit">{record.feature.unit}</span></p>
                <div class="play-who">
                {leaders.map(row => <p class="play-holder"><strong>{who(record.feature, row).map(part => typeof part === 'string' ? part : <a {...person(part.person)}>{part.person}</a>)}</strong><span>{when(record.feature, row)}</span></p>)}
                {others.length > 0 && (
                  <details class="play-next" open={others.some(involves)} data-marked={others.some(involves) || undefined}>
                    <summary>{others.length > 1 ? 'Runners-up' : 'Runner-up'}</summary>
                    <ol>
                      {others.map(row => <li value={row.rank}><span>{who(record.feature, row).map(part => typeof part === 'string' ? part : <a {...person(part.person)}>{part.person}</a>)}</span><span>{value(record, row)}</span></li>)}
                    </ol>
                  </details>
                )}
                </div>
              </li>
            );
          }))}
        </ul>
        </>
        ))}
      </section>
      )}

      <section class="block" id="careers">
        <h2 class="painted" data-yard="30">Careers</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Manager</th><th scope="col">Seasons</th><th scope="col">Record</th><th scope="col">Win %</th><th scope="col">Points</th><th scope="col">Playoffs</th><th scope="col">Titles</th></tr></thead>
            <tbody>
              {history.careers.map(manager => (
                <tr class:list={{ former: !manager.current }}>
                  <th scope="row"><a {...person(manager.name)}>{manager.name}</a><span class="career-range">{manager.range}</span></th>
                  <td>{manager.range}</td>
                  <td>{manager.facts.record}{manager.facts.ties ? `–${manager.facts.ties}` : ''}</td>
                  <td>{manager.facts.winPercentage === null ? '—' : fixed(manager.facts.winPercentage, 1)}</td>
                  <td>{fixed(manager.facts.points, 0)}</td>
                  <td>{manager.facts.playoffAppearances}</td>
                  <td class:list={['titles', { won: manager.facts.championships > 0 }]}>{manager.facts.championships}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {(history.streaks.length > 0 || history.versus.length > 0) && (
        <section class="block" id="rivalries">
          <h2 class="painted" data-yard="40" tabindex="-1">Rivalries</h2>
          {history.versus.length > 0 ? (
            <div class="table-wrap">
              <table class="versus">
                <caption><a {...person(history.marked!.name)}>{history.marked!.name}</a> head to head</caption>
                <thead><tr><th scope="col">Opponent</th><th scope="col">Record</th><th scope="col">Streak</th></tr></thead>
                <tbody>
                  {history.versus.map(row => (
                    <tr class:list={{ former: !row.current }}>
                      <th scope="row"><a {...person(row.name)}>{row.name}</a></th>
                      <td class:list={['versus-record', { up: row.edge > 0, down: row.edge < 0 }]}>{row.record}</td>
                      <td class="versus-streak">{row.streak ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : <>
          {history.streaks.slice(0, 1).map(streak => (
            <div class="streak-top">
              <p class="streak-run"><span class="streak-big">{streak.count}</span><span class="painted">straight</span></p>
              <p class="streak-who"><a {...person(streak.winner)}>{streak.winner}</a> has beaten <a {...person(streak.loser)}>{streak.loser}</a></p>
              <p class="streak-record">{streak.record} all time, playoffs included</p>
            </div>
          ))}
          {history.streaks.length > 1 && (
            <ul class="streaks">
              {history.streaks.slice(1).map(streak => (
                <li>
                  <span class="streak-count">{streak.count}</span>
                  <p><a {...person(streak.winner)}>{streak.winner}</a> has beaten <a {...person(streak.loser)}>{streak.loser}</a><span>{streak.record} all time, playoffs included</span></p>
                </li>
              ))}
            </ul>
          )}
          </>}
        </section>
      )}
      <p class="copied" role="status"></p>
    </>
  )}
  {history?.reigning && (
    <footer slot="close" class="endzone close">
      <div class="endzone-inner">
        <p class="painted close-name">{history.reigning.champions.map((champion, index) => <>{index > 0 && ' & '}<a {...person(champion)}>{champion}</a></>)}</p>
        <p class="league-years">{history.reigning.year} champion{history.reigning.titles > 1 && ` · ${history.reigning.titles} titles`}</p>
      </div>
    </footer>
  )}
</Base>

<script>
  // One live region, shown briefly, for both the copied link and the highlight.
  let timer = 0;
  const say = (text: string) => {
    const status = document.querySelector('.copied')!;
    status.textContent = text;
    clearTimeout(timer);
    timer = window.setTimeout(() => { status.textContent = ''; }, 1800);
  };

  // Without JS the share link is a plain anchor; with it, phones get the share sheet and desktops copy the link.
  // The shared link is the record alone: the sharer's ?u= and ?manager= describe their view, not the recipient's.
  document.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.share');
    if (!link || !navigator.share && !navigator.clipboard) return;
    event.preventDefault();
    const url = `${location.origin}${location.pathname}${link.hash}`;
    history.replaceState(null, '', link.hash);
    if (navigator.share && matchMedia('(pointer: coarse)').matches) navigator.share({ url }).catch(() => {});
    else navigator.clipboard.writeText(url).then(() => say('Link copied'));
  });

  // With JS, highlighting a manager repaints in place instead of reloading to the top; the URL still carries it for sharing.
  document.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-person], .marking a');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const url = new URL(location.href);
    const next = link.dataset.person && link.dataset.person !== url.searchParams.get('manager') ? link.dataset.person : null;
    // The end zone's highlight row and opened runners-up change height above the tap; the tapped name holds still.
    const top = link.getBoundingClientRect().top;
    if (next) url.searchParams.set('manager', next); else url.searchParams.delete('manager');
    history.replaceState(null, '', url.pathname + url.search + url.hash);
    document.querySelectorAll<HTMLAnchorElement>('a[data-person]').forEach(element => {
      const on = element.dataset.person === next;
      element.classList.toggle('me', on);
      on ? element.setAttribute('aria-current', 'true') : element.removeAttribute('aria-current');
      const target = new URL(url);
      if (on) target.searchParams.delete('manager'); else target.searchParams.set('manager', element.dataset.person!);
      element.href = target.pathname + target.search;
    });
    // A highlighted runner-up opens its box so the mark is never hidden; a box opened that way closes when the mark moves on.
    document.querySelectorAll<HTMLDetailsElement>('.play-next').forEach(box => {
      const holds = !!box.querySelector('.me');
      if (holds || box.hasAttribute('data-marked')) box.open = holds;
      box.toggleAttribute('data-marked', holds);
    });
    document.querySelector('.marking-name')!.textContent = next;
    document.querySelector<HTMLElement>('.marking')!.hidden = !next;
    if (!link.closest('.marking')) scrollBy({ top: link.getBoundingClientRect().top - top, behavior: 'instant' });
    say(next ? `${next} highlighted` : 'Highlight cleared');
    // Rivalries change shape with the highlight, so the server renders it for the new URL and it swaps in; a later tap wins.
    const wanted = url.pathname + url.search;
    fetch(wanted).then(response => response.text()).then(html => {
      const old = document.getElementById('rivalries');
      const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('rivalries');
      if (location.pathname + location.search !== wanted || !old || !fresh) return;
      const focused = old.contains(document.activeElement);
      old.replaceWith(fresh);
      watch.observe(fresh);
      if (focused) fresh.querySelector('h2')!.focus({ preventScroll: true });
    });
  });

  // The jump bar marks the section under the top third of the screen. Without JS it just has no mark.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.jump a')];
  const mark = () => {
    // Looked up each time: Rivalries is replaced when the highlight changes.
    const sections = links.map(link => document.getElementById(link.hash.slice(1))!);
    const current = sections.findLast(section => section.getBoundingClientRect().top <= innerHeight * 0.3);
    links.forEach((link, index) => sections[index] === current ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
  };
  const watch = new IntersectionObserver(mark, { rootMargin: '-30% 0px -69% 0px' });
  links.forEach(link => watch.observe(document.getElementById(link.hash.slice(1))!));
</script>
