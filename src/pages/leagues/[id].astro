---
import Base from '../../layouts/Base.astro';
import { ensureLeague, leagueStorePath } from '../../leagues.ts';
import { withHistorySnapshot } from '../../history/store.ts';
import { readSeasons } from '../../history/read.ts';
import { readManagers } from '../../history/managers.ts';
import { readCategory, formatRecordValue } from '../../history/records.ts';
import { readRivalry } from '../../history/rivalries.ts';

const { id = '' } = Astro.params;
if (!/^\d+$/.test(id)) return new Response(null, { status: 404 });
let failure: string | null = null;
try {
  await ensureLeague(id);
} catch (error) {
  console.error(`League ${id} import failed`, error);
  failure = 'Sleeper didn’t return this league’s history. Check the league link, or pick the league again from your username.';
}

interface Feature { key: string; name: string; unit: string }
const halls: { name: string; features: Feature[] }[] = [
  { name: 'Hall of fame', features: [
    { key: 'highest-score', name: 'Highest score', unit: 'points' },
    { key: 'biggest-blowout', name: 'Biggest blowout', unit: 'point margin' },
    { key: 'winning-streak', name: 'Longest winning streak', unit: 'wins in a row' },
    { key: 'closest-game', name: 'Closest game', unit: 'point margin' },
    { key: 'productive-pickup', name: 'Best pickup', unit: 'points as a starter' },
  ] },
  { name: 'Hall of shame', features: [
    { key: 'lowest-score', name: 'Lowest score', unit: 'points' },
    { key: 'losing-streak', name: 'Longest losing streak', unit: 'losses in a row' },
    { key: 'best-without-title', name: 'Best season without a title', unit: 'above league scoring' },
    { key: 'unluckiest-season', name: 'Unluckiest season', unit: 'wins below expected' },
    { key: 'benched-player', name: 'Most points left on the bench', unit: 'points' },
    { key: 'productive-drop', name: 'Worst drop', unit: 'points for other teams' },
  ] },
];

const storePath = leagueStorePath(id);
const history = failure ? null : await withHistorySnapshot(async () => {
  const seasons = (await readSeasons(storePath))!;
  const managers = (await readManagers({ storePath }))!;
  const nameOf = new Map(managers.map(manager => [manager.id, manager.name]));
  const plates = seasons.toReversed().map(season => ({
    year: season.year, complete: season.complete,
    champion: season.teams.filter(team => team.finish === 1).map(team => nameOf.get(team.personId) ?? team.name).join(' & '),
  }));
  const recordHalls = await Promise.all(halls.map(async hall => ({
    name: hall.name,
    records: (await Promise.all(hall.features.map(async feature => ({ feature, view: await readCategory(feature.key, { storePath }) }))))
      .filter(({ view }) => view && !view.blocked && view.rows.length)
      .map(({ feature, view }) => ({ feature, percent: view!.category.unit === '%', precision: view!.category.displayPrecision ?? 2, rows: view!.rows.filter(row => row.rank <= 3).slice(0, 3) })),
  })));
  const careers = managers.toSorted((a, b) => b.facts.championships - a.facts.championships || (b.facts.winPercentage ?? -1) - (a.facts.winPercentage ?? -1) || a.name.localeCompare(b.name));
  const streaks = [];
  for (const [index, a] of managers.entries()) for (const b of managers.slice(index + 1)) {
    const rivalry = await readRivalry(a.id, b.id, { storePath });
    if (!rivalry?.streak || rivalry.streak.result !== 'W' && rivalry.streak.result !== 'L' || rivalry.streak.count < 3) continue;
    const winnerIsA = rivalry.streak.person.id === a.id;
    streaks.push({ winner: rivalry.streak.person.name, loser: winnerIsA ? b.name : a.name, count: rivalry.streak.count,
      record: winnerIsA ? `${rivalry.wins}–${rivalry.losses}` : `${rivalry.losses}–${rivalry.wins}` });
  }
  streaks.sort((a, b) => b.count - a.count || a.winner.localeCompare(b.winner));
  return { name: seasons[0].name, first: seasons.at(-1)!.year, last: seasons[0].year, plates, recordHalls, careers, streaks: streaks.slice(0, 5) };
}, storePath);

type Row = { value: number; name: string; leaderContext?: string; secondary?: { name: string }[]; matchupLabel?: string };
const value = (record: { percent: boolean; precision: number }, row: Row) =>
  record.percent ? `${row.value > 0 ? '+' : ''}${formatRecordValue(row.value, 1)}%` : formatRecordValue(row.value, record.precision);
const who = (row: Row) => row.matchupLabel && row.secondary?.[0] ? `${row.name} over ${row.secondary[0].name}` : row.name;
const when = (row: Row) => row.leaderContext?.replaceAll(' · ', ', ') ?? '';
---
<Base title={history ? `${history.name} history` : 'League history'}>
  <Fragment slot="band">
    {failure && <p class="notice">{failure}</p>}
    {history && (
      <>
        <h1 class="league-name">{history.name}</h1>
        <p class="league-years">{history.first}–{history.last}</p>
        <ol class="plates" aria-label="Champions">
          {history.plates.map(plate => (
            <li class:list={['plate', { blank: !plate.complete }]}>
              <span class="plate-year">{plate.year}</span>
              <span class="plate-name">{plate.complete ? plate.champion || '—' : ''}</span>
            </li>
          ))}
        </ol>
      </>
    )}
  </Fragment>

  {history && (
    <>
      <div class="halls">
        {history.recordHalls.map(hall => (
          <section class="hall">
            <h2>{hall.name}</h2>
            <ul class="feats">
              {hall.records.map(record => {
                const leaders = record.rows.filter(row => row.rank === 1);
                const others = record.rows.filter(row => row.rank !== 1);
                return (
                  <li class="feat">
                    <h3>{record.feature.name}</h3>
                    <div class="feat-body">
                      <p class="feat-figure"><span class="feat-value">{value(record, leaders[0])}</span><span class="feat-unit">{record.feature.unit}</span></p>
                      <div class="feat-holders">
                        {leaders.map(row => <p class="feat-holder"><strong>{who(row)}</strong><span>{when(row)}</span></p>)}
                        {others.length > 0 && (
                          <ol class="feat-next">
                            {others.map(row => <li value={row.rank}><span>{who(row)}</span><span class="num">{value(record, row)}</span></li>)}
                          </ol>
                        )}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>

      <section class="block">
        <h2>Careers</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Manager</th><th scope="col">Seasons</th><th scope="col">Record</th><th scope="col">Win %</th><th scope="col">Points</th><th scope="col">Playoffs</th><th scope="col">Titles</th></tr></thead>
            <tbody>
              {history.careers.map(manager => (
                <tr class:list={{ former: !manager.current }}>
                  <th scope="row">{manager.name}</th>
                  <td>{manager.range}</td>
                  <td>{manager.facts.record}{manager.facts.ties ? `–${manager.facts.ties}` : ''}</td>
                  <td>{manager.facts.winPercentage === null ? '—' : formatRecordValue(manager.facts.winPercentage, 1)}</td>
                  <td>{formatRecordValue(manager.facts.points, 0)}</td>
                  <td>{manager.facts.playoffAppearances}</td>
                  <td class="titles" aria-label={`${manager.facts.championships} titles`}>
                    {Array.from({ length: manager.facts.championships }, () => <span class="ring" />)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {history.streaks.length > 0 && (
        <section class="block">
          <h2>Head-to-head streaks</h2>
          <ul class="streaks">
            {history.streaks.map(streak => (
              <li>
                <span class="streak-count">{streak.count}</span>
                <p><strong>{streak.winner}</strong> has beaten <strong>{streak.loser}</strong> {streak.count} straight. {streak.record} all time.</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</Base>
