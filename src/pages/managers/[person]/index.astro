---
import MuseumLayout from '../../../layouts/MuseumLayout.astro';
import ProfileContext from '../../../components/ProfileContext.astro';
import ProfileHistoryControls from '../../../components/ProfileHistoryControls.astro';
import ProfileSeasonHistory from '../../../components/ProfileSeasonHistory.astro';
import StreakHistory from '../../../components/StreakHistory.astro';
import ProfileRivalries from '../../../components/ProfileRivalries.astro';
import { readManagerRivalries } from '../../../history/rivalries';
import Contributors from '../../../components/Contributors.astro';
import { readContributors } from '../../../history/contributions';
import { readManager } from '../../../history/managers';
import { readStreakHistory } from '../../../history/game-records';
import { gameScopes } from '../../../history/read';
import type { Scope } from '../../../history/types';
import '../../../styles/profiles.css';
const { person = '' } = Astro.params;
const selected = Astro.url.searchParams;
const tab = ['rivalries', 'players'].includes(selected.get('tab')!) ? selected.get('tab')! : 'seasons';
const scope = gameScopes.includes(selected.get('scope') as Scope) ? selected.get('scope') as Scope : 'regular';
let profile = await readManager(person, { scope });
const season = profile?.years.includes(selected.get('season')!) ? selected.get('season')! : undefined;
if (profile && (selected.has('scope') && selected.get('scope') !== scope || selected.has('season') && selected.get('season') !== season || selected.has('tab') && !['seasons', 'rivalries', 'players'].includes(selected.get('tab')!))) return Astro.redirect(`/managers/${person}/?tab=${tab}&scope=${scope}${season ? `&season=${season}` : ''}`, 302);
if (season) profile = await readManager(person, { scope, season });
const streak = tab === 'seasons' ? await readStreakHistory(person, { scope, season, streak: selected.get('streak'), from: selected.get('from'), through: selected.get('through') }) : null;
if (!profile) Astro.response.status = 404;
const rivalries = profile && tab === 'rivalries' ? await readManagerRivalries(profile.id, { scope, season }) : null;
const players = tab === 'players' ? await readContributors({ personId: person }, { scope, season }) : null;
---
<MuseumLayout title={profile?.name ?? 'Manager not found'} section="Managers">
  {profile ? <>
    <ProfileContext profile={profile} />
    <ProfileHistoryControls kind="manager" tab={tab} scope={scope} years={profile.years} season={season} />
    {tab === 'rivalries' ? <ProfileRivalries rows={rivalries?.rows ?? []} nemeses={rivalries?.nemeses ?? []} /> : players ? <Contributors selection={players} /> : streak ? <StreakHistory history={streak} /> : <ProfileSeasonHistory rows={profile.seasons} basePath={`/managers/${profile.id}`} scope={scope} managerName={profile.name} />}
  </> : <div class="not-found"><h1>Manager not found</h1><p>This person is not in the league’s history.</p><a href="/managers/">Browse managers</a></div>}
</MuseumLayout>
