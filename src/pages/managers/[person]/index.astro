---
import MuseumLayout from '../../../layouts/MuseumLayout.astro';
import ProfileContext from '../../../components/ProfileContext.astro';
import StreakHistory from '../../../components/StreakHistory.astro';
import ProfileRivalries from '../../../components/ProfileRivalries.astro';
import { readManagerRivalries } from '../../../history/rivalries';
import { readManager } from '../../../history/managers';
import { readStreakHistory } from '../../../history/game-records';
import { gameScopes, competitionLabels } from '../../../history/read';
import type { Scope } from '../../../history/types';
import '../../../styles/profiles.css';
const { person = '' } = Astro.params;
const selected = Astro.url.searchParams;
const tab = selected.get('tab') === 'rivalries' ? 'rivalries' : 'seasons';
const scope = gameScopes.includes(selected.get('scope') as Scope) ? selected.get('scope') as Scope : 'regular';
let profile = await readManager(person, { scope });
const season = profile?.years.includes(selected.get('season')!) ? selected.get('season')! : undefined;
if (profile && (selected.has('scope') && selected.get('scope') !== scope || selected.has('season') && selected.get('season') !== season || selected.has('tab') && selected.get('tab') !== tab)) return Astro.redirect(`/managers/${person}/?tab=${tab}&scope=${scope}${season ? `&season=${season}` : ''}`, 302);
if (season) profile = await readManager(person, { scope, season });
const streak = tab === 'seasons' ? await readStreakHistory(person, { scope, season, streak: selected.get('streak'), from: selected.get('from'), through: selected.get('through') }) : null;
if (!profile) Astro.response.status = 404;
const rivalries = profile && tab === 'rivalries' ? await readManagerRivalries(profile.id, { scope, season }) : null;
const number = (value: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 8 }).format(value);
---
<MuseumLayout title={profile?.name ?? 'Manager not found'} section="Managers">
  {profile ? <>
    <ProfileContext profile={profile} />
    <div class="profile-local-heading">
      <nav class="local-tabs" aria-label="Manager views"><a href={`?tab=seasons&scope=${scope}${season ? `&season=${season}` : ''}`} aria-current={tab === 'seasons' ? 'page' : undefined}>Seasons</a><a href={`?tab=rivalries&scope=${scope}${season ? `&season=${season}` : ''}`} aria-current={tab === 'rivalries' ? 'page' : undefined}>Rivalries</a></nav>
      <form method="get" class="profile-controls">
        <input type="hidden" name="tab" value={tab} />
        <label for="profile-season">Season</label><select id="profile-season" name="season"><option value="" selected={!season}>All seasons</option>{profile.years.map(year => <option value={year} selected={season === year}>{year}</option>)}</select>
        <label for="profile-scope">Game scope</label><select id="profile-scope" name="scope">{gameScopes.map(value => <option value={value} selected={scope === value}>{competitionLabels[value]}</option>)}</select>
        <button type="submit">Show history</button>
      </form>
    </div>
    {tab === 'rivalries' ? <ProfileRivalries rows={rivalries?.rows ?? []} nemeses={rivalries?.nemeses ?? []} /> : streak ? <StreakHistory history={streak} /> : <table class="history-table career-seasons-table">
      <caption class="visually-hidden">Season history</caption>
      <thead><tr><th scope="col">Year / team</th><th scope="col">Record</th><th scope="col">Points</th><th scope="col">Finish</th><th scope="col">Playoffs</th></tr></thead>
      <tbody>{profile.seasons.map(row => <tr>
        <th scope="row"><a href={`/managers/${profile.id}/seasons/${row.year}/?scope=${scope}`}>{row.year}</a><span class="historical-team">{row.name}</span></th>
        <td data-label="Record">{row.facts.record}</td><td data-label="Points">{number(row.facts.points)}</td><td data-label="Finish">{row.finish ?? '—'}</td>
        <td data-label="Playoffs">{row.championship ? <a href={`/seasons/${row.year}/?tab=playoffs`}>Champion</a> : row.runnerUp ? <a href={`/seasons/${row.year}/?tab=playoffs`}>Runner-up</a> : row.playoffAppearance ? <a href={`/seasons/${row.year}/?tab=playoffs`}>Qualified</a> : '—'}</td>
      </tr>)}</tbody>
    </table>}
  </> : <div class="not-found"><h1>Manager not found</h1><p>This person is not in the league’s history.</p><a href="/managers/">Browse managers</a></div>}
</MuseumLayout>
