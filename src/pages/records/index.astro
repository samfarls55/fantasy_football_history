---
import MuseumLayout from '../../layouts/MuseumLayout.astro';
import { readRecordCollection, formatRecordValue, recordUnit } from '../../history/records';
import '../../styles/records.css';
const groups = await readRecordCollection();
if (!groups) Astro.response.status = 503;
---
<MuseumLayout title="Records" section="Records">
  <div class="page-heading"><h1>Records</h1></div>
  {groups ? <div class="record-collection">{groups.map(group => <section aria-labelledby={`group-${group.name}`}>
    <h2 id={`group-${group.name}`}>{group.name}</h2>
    <table class="collection-table">
      <caption class="visually-hidden">{group.name} records</caption>
      <thead><tr><th scope="col">Record</th><th scope="col">Holder</th><th scope="col">Value</th></tr></thead>
      <tbody>{group.categories.map(category => <tr>
        <th scope="row">{category.href ? <a href={category.href}>{category.name}</a> : category.name}</th>
        <td data-label="Holder">{category.leaders.length ? category.leaders.map((leader, index) => <span>{index > 0 && ', '}{leader.name}{category.leaders.length > 1 && leader.sample && <span class="record-sample">{leader.sample}</span>}</span>) : '—'}</td>
        <td data-label="Value">{category.leaders.length ? <><strong>{formatRecordValue(category.leaders[0].value, category.displayPrecision)}{category.unit === '%' ? '%' : ` ${recordUnit(category.unit, category.leaders[0].value)}`}</strong>{category.leaders.length === 1 && category.leaders[0].sample && <span class="record-sample">{category.leaders[0].sample}</span>}</> : '—'}</td>
      </tr>)}</tbody>
    </table>
  </section>)}</div> : <p class="empty-history">League history is unavailable.</p>}
</MuseumLayout>
