---
// Manager stats as one sortable table, their columns in the order given.
import StatTable from './StatTable.astro';
import type { StatView } from '../history/manager-stats.ts';

interface Props {
  labelledby: string;
  stats: StatView[];
  /** The columns that set the order served. Without it, the first one. */
  by?: string[];
}
const { labelledby, stats, by = [stats[0]?.key] } = Astro.props;
const managers = [...new Map(stats.flatMap(stat => stat.rows).map(row => [row.personId, { id: row.personId, name: row.name, current: row.current }])).values()];
const columns = stats.map(({ rows, ...stat }) => ({ ...stat, cells: new Map(rows.map(({ personId, figure, value, sample, names, unit }) =>
  [personId, { figure, sort: value, sample, ...names && { text: names.join(', '), unit } }])) }));
---
{stats.length > 0 && <StatTable labelledby={labelledby} managers={managers} columns={columns} by={by} />}
