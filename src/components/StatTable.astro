---
// The sortable table: one row per manager, a painted label over each column, current managers over the dashed line and former ones under it.
import Manager from './Manager.astro';
import Names from './Names.astro';
import ShareLink from './ShareLink.astro';
import type { StatColumn } from '../stat-table.ts';

interface Props {
  /** The ID of the heading that names the table. */
  labelledby: string;
  managers: { id: string; name: string; current: boolean }[];
  columns: StatColumn[];
  /** The columns that set the order served, the first one leading. One this league has no value for is passed over. */
  by: string[];
}
const { labelledby, managers, by } = Astro.props;
// A column of names reads from the left, the rest line their figures up on the right.
const columns = Astro.props.columns.map(column => ({ ...column, named: [...column.cells.values()].some(cell => cell.names) }));
const keys = by.flatMap(key => columns.find(column => column.key === key) ?? []);
const order = managers.toSorted((a, b) => {
  for (const { better, cells } of keys) {
    const [left, right] = [cells.get(a.id)?.sort, cells.get(b.id)?.sort];
    if (a.current !== b.current || left === right) continue;
    if (left === undefined || right === undefined) return left === undefined ? 1 : -1;
    return better === 'higher' ? right - left : left - right;
  }
  return Number(b.current) - Number(a.current) || a.name.localeCompare(b.name);
});
// Figures share the room evenly and a column of names takes two shares, so the gaps between columns match; the managers keep what's left.
const shares = columns.reduce((sum, column) => sum + (column.named ? 2 : 1), 0);
// A table of many columns has no room to share out: each takes what its figures need, on a tighter gap.
const many = shares > 7;
const share = (named: boolean) => many ? undefined : `--share: ${(78 / shares * (named ? 2 : 1)).toFixed(2)}%`;
// Columns whose samples match on every row ("105 weeks", "of 105 weeks") say it once, under the manager, and the other columns keep their own.
// The largest such set of columns wins, the first on a tie, so every row of a table shares the same ones.
const counted = (sample?: string) => sample?.replace(/^(of|in|over) /, '');
const sampled = columns.filter(column => [...column.cells.values()].some(cell => cell.sample));
const sets = sampled.map(lead => sampled.filter(other => managers.every(({ id }) => {
  const [a, b] = [lead.cells.get(id), other.cells.get(id)];
  return !a || !b || counted(a.sample) === counted(b.sample);
})));
const shared = new Set(sets.toSorted((a, b) => b.length - a.length).find(set => set.length > 1));
const sampleOf = (id: string) => counted([...shared].map(column => column.cells.get(id)?.sample).find(Boolean));
---
<div class="table-wrap">
  <table class:list={['stats', { many }]} aria-labelledby={labelledby}>
    <thead>
      <tr>
        <th scope="col"><span class="stat-label">Manager</span></th>
        {columns.map(column => (
          <th scope="col" id={column.key} class:list={{ named: column.named }} style={share(column.named)} data-better={column.better} aria-sort={column === keys[0] ? column.better === 'higher' ? 'descending' : 'ascending' : undefined}>
            <span class:list={['stat-label', { long: column.label.length > 24 }]}>{column.label.replace(' %', ' %').split(': ').map((part, index, all) => index ? <span class="stat-counts">{part}</span> : <span>{part}{all.length > 1 && <span class="unseen">: </span>}</span>)}</span>
            <details class="play-how"><summary class="play-unit"><span>{column.unit.replaceAll('–', '⁠–⁠')}</span></summary><p>{column.rule}<ShareLink label={`Share ${column.label}`} hash={`#${column.key}`} /></p></details>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {order.map(manager => (
        <tr class:list={{ former: !manager.current }}>
          <th scope="row" data-sort={manager.name}><Manager name={manager.name} />{(!manager.current || sampleOf(manager.id)) && <span class="former-mark"> {[!manager.current && 'Former', sampleOf(manager.id)].filter(Boolean).join(', ')}</span>}</th>
          {columns.map(column => {
            const { key, cells, named } = column;
            const cell = cells.get(manager.id);
            const sample = shared.has(column) ? undefined : cell?.sample;
            return cell ? (
              <td class:list={{ named, several: cell.names && cell.names.length > 1 }} data-column={key} data-sort={cell.sort}>
                {cell.names && <div class="stat-text"><Names names={cell.names} /></div>}
                <span class="stat-counted"><span class="stat-figure">{cell.figure}</span>{cell.unit && ` ${cell.unit}`}{sample && cell.names && cell.names.length > 1 && ','}</span>{' '}
                {sample && <span class="stat-sample">{sample}</span>}
              </td>
            ) : <td class:list={{ named }}><span aria-hidden="true">—</span><span class="unseen">No figure</span></td>;
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Each label becomes a button that sorts by its column: the better end first, a second press flips it, names A to Z.
  // Former managers stay below the dashed line, unknowns trail, and ties keep the served order. Without JS the served order stands.
  for (const table of document.querySelectorAll<HTMLTableElement>('table.stats')) {
    const headers = [...table.tHead!.rows[0].cells];
    const served = [...table.tBodies[0].rows];
    headers.forEach((header, column) => {
      const button = document.createElement('button');
      button.type = 'button';
      const label = header.querySelector('.stat-label')!;
      label.replaceWith(button);
      button.append(label);
      button.addEventListener('click', () => {
        const named = column === 0;
        const ascending = header.ariaSort ? header.ariaSort === 'descending' : named || header.dataset.better === 'lower';
        for (const other of headers) other.removeAttribute('aria-sort');
        header.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
        const key = (row: HTMLTableRowElement) => row.cells[column].dataset.sort;
        const former = (row: HTMLTableRowElement) => Number(row.classList.contains('former'));
        const compare = (a: HTMLTableRowElement, b: HTMLTableRowElement) => {
          const [left, right] = [key(a), key(b)];
          if (left === undefined || right === undefined) return Number(left === undefined) - Number(right === undefined);
          return (named ? left.localeCompare(right) : Number(left) - Number(right)) * (ascending ? 1 : -1);
        };
        table.tBodies[0].append(...served.toSorted((a, b) => former(a) - former(b) || compare(a, b) || served.indexOf(a) - served.indexOf(b)));
      });
    });
  }
</script>
