---
import Manager from './Manager.astro';
import ShareLink from './ShareLink.astro';
import Winners from './Winners.astro';
import { fixed, isViewer } from '../league-page.ts';
import { recordUnit, type readCategory } from '../history/records.ts';

interface Props {
  view: NonNullable<Awaited<ReturnType<typeof readCategory>>>;
  heading: 'h2' | 'h3';
  /** The card's place in its run, for the stagger. */
  index: number;
  headline?: boolean; wide?: boolean; across?: boolean;
}
const { view: { category, rows, leaders }, heading: Title, index, headline, wide, across } = Astro.props;
type Row = typeof rows[number];
// Ties share a rank, so every row ranked third or better shows; none drops silently.
const others = rows.filter(row => row.rank > 1 && (row.rank <= 3 || category.rest));
// One fixed precision per record so a figure and its runners-up line up; a percentage keeps the precision its category chose so distinct ranked values never share a label (docs/metrics.md).
const value = (row: Row) => `${category.signed && row.value > 0 ? '+' : ''}${fixed(row.value, category.displayPrecision)}${category.percent ? '%' : ''}`;
const unit = category.displayPrecision === 0 ? recordUnit(category.unit, leaders[0].value) : category.unit;
// Every context reads "Week 3, 2020" (a streak "Weeks 1–12, 2023"), and a date never breaks across lines. Player records lead it with the manager, already named as the holder.
// A season record reads the way the league remembers it: "11–3, 128.4 points a game in 2024".
const when = (row: Row) => row.record ? `${row.record}, ${fixed(row.pointsPerGame!, 1)} points a game in\u00a0${row.leaderContext!.slice(0, 4)}`
  : (row.leaderContext ?? row.sample ?? '').split(' · ').slice(category.verb ? 1 : 0).join(', ').replace(/Week (\d+), (\d{4}) – Week (\d+), \2/, 'Weeks\u00a0$1–$3,\u00a0$2').replace(/Week (\d+), (\d{4})/g, 'Week\u00a0$1,\u00a0$2');
// How the holder fared against the opponent.
const met = (row: Row) => row.sides ? ' out-traded ' : row.tied ? ' tied ' : row.lost ? ' lost to ' : ' beat ';
// What each side of a trade received, and what it scored: "Ann received Player A, Player B: 63.25 points".
const hauls = (row: Row) => (row.sides ?? []).map(side => `${side.manager} received ${side.received.length ? `${side.received.join(', ')}: ${fixed(side.points, category.displayPrecision)} points` : 'nothing'}`);
const involves = (row: Row) => [row.manager, row.opponent, ...(row.winners ?? []).map(winner => winner.manager)].some(name => name && isViewer(Astro, name));
// Each thrown flag lands its own way: tilt, mirror and a nudge, fixed per record so reloads match.
const hash = [...category.key].reduce((sum, char) => (sum * 31 + char.charCodeAt(0)) >>> 0, 7);
const landing = `--tilt: ${hash % 27 - 15}deg; --flip: ${hash >> 4 & 1 ? -1 : 1}; --dx: ${-(hash >> 5) % 10}px; --dy: ${(hash >> 9) % 9 - 3}px`;
---
<li id={category.key} class:list={['play', { shame: category.shame, headline, wide, across }]} style={`--i: ${index}; ${landing}`}>
  {category.shame && (
    <svg class="flag" viewBox="0 0 56 46" aria-hidden="true">
      <path class="flag-cloth" d="M13 11c9-6 20-3 30-6 4-1 8 0 10 2l-3 26c-8 4-17 1-25 4-5 2-10 3-14 1z" />
      <path class="flag-fold" d="M30 7c-2 9-1 19 1 29" />
      <circle class="flag-knot" cx="11" cy="11" r="7" />
    </svg>
  )}
  <Title class="play-title"><span class="unseen">{category.shame ? 'Shame: ' : 'Fame: '}</span>{category.name}<ShareLink label={`Share ${category.name}`} hash={`#${category.key}`} /></Title>
  <div class="play-figure"><span class="play-value">{value(leaders[0])}</span><details class="play-how"><summary class="play-unit">{unit}</summary><p>{category.rule}</p></details></div>
  <div class="play-who">
    {leaders.map(row => (
      <p class="play-holder"><strong>{row.manager ? <Manager name={row.manager} /> : row.name}{category.verb ? ` ${category.verb} ${row.name}` : row.opponent && <>{met(row)}<Manager name={row.opponent} /></>}</strong>{when(row) && <span>{when(row)}</span>}{row.winners && <Winners winners={row.winners} />}{hauls(row).map(haul => <span>{haul}</span>)}</p>
    ))}
    {others.length > 0 && (
      <details class="play-next" open={others.some(involves)}>
        <summary>{category.rest ?? `${others.length} ${others.length > 1 ? 'runners-up' : 'runner-up'}`}</summary>
        <ol>
          {others.map(row => <li><span class="next-rank">{row.rank}</span><span class="next-value">{value(row)}{category.rest && ` ${recordUnit(category.unit, row.value)}`}</span><span class="next-who">{row.manager ? <Manager name={row.manager} /> : row.name}{category.verb ? ` ${category.verb} ${row.name}` : row.opponent && <>{met(row)}<Manager name={row.opponent} /></>}</span><span class="next-when">{when(row)}{row.winners && <Winners winners={row.winners} />}</span>{hauls(row).map(haul => <span class="next-when">{haul}</span>)}</li>)}
        </ol>
      </details>
    )}
  </div>
</li>
