---
// One row of ranks: a stat that opens its column, what this manager's is, and where that places them.
import Names from './Names.astro';
interface Props { href: string; label: string; rule: string; figure: string; unit: string; names?: string[]; sample?: string; rank: number; standing: string; of: string }
const { href, label, rule, figure, unit, names, sample, rank, standing, of } = Astro.props;
---
<li>
  <a href={href}>{label}</a>
  <div class="rank-value">
    {names && <div class="stat-text"><Names names={names} /></div>}
    <span class="stat-figure">{figure}</span>
    <details class="play-how"><summary class="play-unit">{unit}</summary><p>{rule}</p></details>
    {sample && <span class="stat-sample">{sample}</span>}
  </div>
  <p class:list={['rank-place', { first: rank === 1 }]}><strong>{standing}</strong> of {of}</p>
</li>
