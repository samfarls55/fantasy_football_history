---
import type { readPlayerContributions } from '../history/contributions';
import { gameScopes, competitionLabels } from '../history/read';
import { formatRecordValue } from '../history/records';
import '../styles/contributions.css';
interface Props { history: NonNullable<Awaited<ReturnType<typeof readPlayerContributions>>> }
const { history } = Astro.props;
const franchise = history.context.kind === 'franchise';
---
<div class="page-heading contribution-heading"><h1>{history.player.name}</h1><p>With <a href={history.contextHref}>{history.context.name}</a>{franchise && <span> · Franchise contributions</span>}</p></div>
{history.pickup && <p class="pickup-context">{history.pickup.year} · Week {history.pickup.week} pickup <a href={history.wholeHistoryHref!}>Whole manager history</a></p>}
{history.pickup && <p class="contribution-definition">{history.pickup.departureWeek === history.pickup.week ? `Pickup and departure were both in Week ${history.pickup.week}. No full weeks in this pickup period.` : history.pickup.departureWeek === null ? `Counts actual starts after Week ${history.pickup.week} through season end.` : `Counts actual starts after Week ${history.pickup.week} and before Week ${history.pickup.departureWeek}. The pickup and departure weeks are excluded.`}</p>}
<div class="contribution-summary">
  <dl class="contribution-facts"><div><dt>{history.pickup ? 'pickup starting points' : 'starting-lineup points'}</dt><dd>{formatRecordValue(history.points)}</dd></div><div><dt>{history.starts === 1 ? 'start' : 'starts'}</dt><dd>{history.starts}</dd></div></dl>
  {history.franchiseHref && <a class="franchise-contributions-link" href={history.franchiseHref}>Franchise contributions</a>}
</div>
{!history.pickup && <p class="contribution-definition">Totals count actual starts across all seasons. Bench points are excluded.</p>}
<form class="profile-controls contribution-scope" method="get">{history.pickup && <input type="hidden" name="pickup" value={history.pickup.id} />}<input type="hidden" name="season" value={history.season} /><label for="player-scope">Game scope</label><select id="player-scope" name="scope">{gameScopes.map(value => <option value={value} selected={history.scope === value}>{competitionLabels[value]}</option>)}</select><button type="submit">Show contributions</button></form>
{history.seasons.length ? <table class="history-table contribution-seasons">
  <caption class="visually-hidden">Season contribution totals</caption>
  <thead><tr><th scope="col">Season{franchise ? ' / manager' : ''}</th><th scope="col">Starting points</th><th scope="col">Starts</th></tr></thead>
  <tbody>{history.seasons.map(row => <tr><th scope="row"><a href={row.href}>{row.year}</a>{franchise && <span class="contributor-owners"><a href={`/managers/${row.owner.id}/players/${history.player.id}/?scope=${history.scope}&season=${row.year}`}>{row.owner.name}</a></span>}</th><td data-label="Starting points">{formatRecordValue(row.points)}</td><td data-label="Starts">{row.starts}</td></tr>)}</tbody>
</table> : !history.pickup && <p class="empty-history">No recorded starts in this history.</p>}
<div class="contribution-games-heading"><h2>Games · {history.season}</h2><form method="get" class="profile-controls">{history.pickup && <input type="hidden" name="pickup" value={history.pickup.id} />}<input type="hidden" name="scope" value={history.scope} /><label for="games-season">Games season</label><select id="games-season" name="season">{history.years.map(year => <option value={year} selected={history.season === year}>{year}</option>)}</select><button type="submit">Show games</button></form></div>
{history.games.length ? <table class="history-table contribution-games">
  <caption class="visually-hidden">Contributing games in {history.season}</caption>
  <thead><tr><th scope="col">Week{franchise ? ' / manager' : ''}</th><th scope="col">Opponent</th><th scope="col">Player points</th><th scope="col">Team result</th></tr></thead>
  <tbody>{history.games.map(row => <tr><th scope="row"><a href={row.href}>Week {row.week}</a>{franchise && <span class="contributor-owners"><a href={row.ownerHref}>{row.owner.name}</a></span>}</th><td><a href={row.opponentHref}>{row.opponent.name}</a></td><td data-label="Player points">{formatRecordValue(row.points)}</td><td data-label="Team result">{row.result} {formatRecordValue(row.teamPoints)}–{formatRecordValue(row.opponentPoints)}</td></tr>)}</tbody>
</table> : <p class="empty-history">{history.pickup ? 'No starts in this pickup period for this game scope.' : `No contributing games in ${history.season}.`}</p>}
