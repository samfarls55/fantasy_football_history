---
// Who trades with whom: managers down a sideline and an arc for each pair, as wide as they stand apart, so no two counts share a spot.
// The drawing is for the eye alone; the list under it holds every pair and links the names.
import Manager from './Manager.astro';
import Section from './Section.astro';
import { isViewer } from '../league-page.ts';
import type { readTradeMap } from '../history/trades.ts';

interface Props { map: NonNullable<Awaited<ReturnType<typeof readTradeMap>>> }
const { managers, pairs } = Astro.props.map;
const marked = (...people: typeof managers) => people.some(person => isViewer(Astro, person.name));
const reach = managers.length - 1;
// Drawn with the fewest trades first and the visitor's own last, so nothing covers those.
const arcs = pairs.map(({ a, b, count }) => ({ from: managers.indexOf(a), to: managers.indexOf(b), count, mine: marked(a, b) }))
  .sort((a, b) => Number(a.mine) - Number(b.mine) || a.count - b.count);
---
{pairs.length > 0 && (
  <Section id="trade-map" title="Trade map">
    <details class="play-how"><summary class="play-unit">trades between each pair</summary><p>Every completed trade, whether for players, picks or waiver budget. A three-team trade counts once for each pair.</p></details>
    <div class="trade-map" style={`--reach: ${reach}`} aria-hidden="true">
      <div class="trade-names">{managers.map(person => <div><span data-person class:list={{ me: marked(person) }}>{person.name}</span></div>)}</div>
      <div class="trade-arcs">
        <svg viewBox={`0 0 ${reach} ${managers.length}`} preserveAspectRatio="none">
          {arcs.map(({ from, to, count, mine }) => <path class:list={{ mine }} d={`M0 ${from + 0.5}A${to - from} ${(to - from) / 2} 0 0 1 0 ${to + 0.5}`} stroke-width={1 + Math.min(count, 5)} />)}
        </svg>
        {arcs.map(({ from, to, count, mine }) => <span class:list={['trade-count', { mine }]} style={`left: ${(to - from) / reach * 100}%; top: ${(from + to + 1) / 2 / managers.length * 100}%`}>{count}</span>)}
      </div>
    </div>
    <ul class="trade-pairs" aria-labelledby="trade-map-name">
      {pairs.map(({ a, b, count }) => <li><span class="trade-total"><strong>{count}</strong> {count === 1 ? 'trade' : 'trades'}</span><span class="trade-who"><Manager name={a.name} /> and <Manager name={b.name} /></span></li>)}
    </ul>
  </Section>
)}
