---
import TeamImage from './TeamImage.astro';
import Chevron from './Chevron.astro';
import { formatRecordValue as number } from '../history/records';
import { competitionLabels } from '../history/read';
import type { readManager, Tenure } from '../history/managers';
import type { Person } from '../history/types';
type ManagerProfile = NonNullable<Awaited<ReturnType<typeof readManager>>>;
type Profile = Omit<ManagerProfile, 'tenures' | 'seasons' | 'current' | 'accountId'> & {
  owner?: Person;
  tenures: Array<Tenure & { owner?: Person }>;
  seasons: Array<ManagerProfile['seasons'][number] & { owner?: Person }>;
};
interface Props { profile: Profile; year?: string }
const { profile, year } = Astro.props;
const franchise = Boolean(profile.owner);
const team = year ? profile.seasons.find(season => season.year === year) : null;
const owner = franchise ? team?.owner ?? profile.owner : null;
const relatedName = owner?.name ?? team?.name ?? profile.teamName;
const tenures = year ? profile.tenures.filter(tenure => tenure.start <= year && tenure.end >= year).map(tenure => ({ ...tenure, events: tenure.events.filter(event => event.year === year || event === tenure.events[0]) })) : profile.tenures;
---
<section class="profile-context" aria-label={year ? `${year} season summary` : 'Career summary'}>
  <div class="profile-identity">
    <TeamImage name={team?.name ?? profile.name} src={team?.avatar ?? profile.avatar} />
    <div><h1>{profile.name}</h1>
      {(year || relatedName !== profile.name) && <p class="profile-team">{owner ? <>{relatedName !== profile.name && `${year ? 'Owner' : 'Latest owner'} `}<a href={`/managers/${owner.id}/${year ? `seasons/${year}/` : ''}?scope=${profile.scope}`}>{relatedName === profile.name ? 'Manager season' : owner.name}</a></> : <a href={`/franchises/${team?.franchiseId ?? profile.franchiseId}/${year ? `seasons/${year}/?scope=${profile.scope}` : `?scope=${profile.scope}`}`}>{relatedName === profile.name ? 'Franchise season' : relatedName}</a>}</p>}
      <p class="profile-period">{year ? <><a href={`/seasons/${year}/`}>{year}</a><span aria-hidden="true"> · </span><a href={`/${franchise ? 'franchises' : 'managers'}/${profile.id}/?scope=${profile.scope}`}>{franchise ? 'Full franchise history' : 'Career history'}</a></> : <>Seasons {profile.range}</>}</p>
      {team && <p class="profile-finish">Finish {team.finish ?? '—'}{team.championship ? ' · Champion' : team.runnerUp ? ' · Runner-up' : team.playoffAppearance ? ' · Playoff appearance' : ''}</p>}
    </div>
  </div>
  <div class="profile-statistics">
    <section aria-label={`${competitionLabels[profile.scope]} statistics`}>
      <h2 class="profile-facts-heading">{competitionLabels[profile.scope]} · {year ?? profile.selectedSeason ?? 'All seasons'}</h2>
      <dl class="profile-facts">
        <div><dt>W–L{profile.facts.ties ? '–T' : ''}</dt><dd>{profile.facts.record}</dd></div>
        <div><dt>Win rate <span>· {profile.facts.games} {profile.facts.games === 1 ? 'game' : 'games'}</span></dt><dd>{profile.facts.winPercentage === null ? '—' : `${number(Number(profile.facts.winPercentage.toFixed(2)))}%`}</dd></div>
        <div><dt>Official points</dt><dd>{number(profile.facts.points)}</dd></div>
      </dl>
    </section>
    <dl class="profile-facts profile-honors" aria-label="Season honors">
      <div><dt>Championships</dt><dd>{profile.facts.championships}</dd></div>
      <div><dt>Playoff appearances</dt><dd>{profile.facts.playoffAppearances}</dd></div>
    </dl>
  </div>
</section>
<section class="tenure-timeline" aria-label={franchise ? 'Ownership timeline' : 'Tenure timeline'}>
  {tenures.map(tenure => <div class="timeline-tenure">
    <h2>{tenure.owner && <><a href={`/managers/${tenure.owner.id}/?scope=${profile.scope}`}>{tenure.owner.name}</a><span aria-hidden="true"> · </span></>}{year ?? tenure.range}</h2>
    <ol>{tenure.events.map(event => <li><strong>{event.year}</strong><p>{event.predecessor ? <>Took over from <a href={`/managers/${event.predecessor.id}/`}>{event.predecessor.name}</a></> : event.label}</p></li>)}</ol>
    {tenure.owner ? <a class="franchise-history-link" href={`/managers/${tenure.owner.id}/?scope=${profile.scope}`}>Manager career <Chevron /></a> : <a class="franchise-history-link" href={`/franchises/${tenure.franchiseId}/?scope=${profile.scope}`}>Full franchise history <Chevron /></a>}
  </div>)}
</section>
