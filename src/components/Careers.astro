---
import Section from './Section.astro';
import Stats from './Stats.astro';
import type { StatView } from '../history/manager-stats.ts';

interface Props { stats: StatView[] }
const { stats } = Astro.props;
---
<Section id="careers" title="Careers">
  <Stats labelledby="careers-name" stats={stats} by={['titles', 'win-rate']} />
</Section>
