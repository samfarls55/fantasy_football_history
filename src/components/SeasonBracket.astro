---
import { competitionLabels, type readSeasonBracket } from '../history/read';
interface Props { selection: NonNullable<Awaited<ReturnType<typeof readSeasonBracket>>> }
const { selection } = Astro.props;
const format = (value: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 8 }).format(value);
const width = 340;
const gap = 64;
const rowStep = 210;
const games = selection.rounds.flatMap(round => round.games);
const positions = new Map<string, number>();
let nextRow = 0;
for (const round of selection.rounds) {
 const occupied: number[] = [];
 for (const game of round.games) {
  const parents = [game.fromA, game.fromB].flatMap(edge => {
    const parent = edge && games.find(parent => parent.family === game.family && parent.match === edge.match);
    return parent && positions.has(parent.id) ? [positions.get(parent.id)!] : [];
  });
  let position = parents.length ? parents.reduce((sum, value) => sum + value, 0) / parents.length : nextRow++;
  while (occupied.some(value => Math.abs(position - value) < 1)) position += 1;
  positions.set(game.id, position);
  occupied.push(position);
 }
}
// Disconnected placement rounds keep their own compact reading order.
if (selection.scope === 'placement') for (const round of selection.rounds) round.games.forEach((game, index) => positions.set(game.id, index));
const canvasWidth = selection.rounds.length * width + Math.max(0, selection.rounds.length - 1) * gap;
const canvasHeight = (Math.max(0, ...positions.values()) + 1) * rowStep;
const connections = games.flatMap(game => [game.fromA, game.fromB].flatMap(edge => {
  const parent = edge && games.find(parent => parent.family === game.family && parent.match === edge.match);
  if (!parent) return [];
  const x1 = selection.rounds.findIndex(round => round.round === parent.round) * (width + gap) + width;
  const x2 = selection.rounds.findIndex(round => round.round === game.round) * (width + gap);
  const y1 = positions.get(parent.id)! * rowStep + 82;
  const y2 = positions.get(game.id)! * rowStep + 82;
  return [`M ${x1} ${y1} H ${x1 + gap / 2} V ${y2} H ${x2}`];
}));
const heading = (game: typeof games[number]) => {
  const name = game.championship || game.placement === 1 ? 'Final' : game.placement === 3 ? 'Third place' : game.placement === 5 ? 'Fifth place' : `Round ${game.round}`;
  const weeks = game.weeks.length > 1 ? `Weeks ${game.weeks[0]}–${game.weeks.at(-1)}` : `Week ${game.weeks[0]}`;
  return `${name} · ${weeks}`;
};
const roundHeading = (round: typeof selection.rounds[number]) => round.games.length === 1 && (round.games[0].championship || round.games[0].placement === 1) ? 'Final' : `Round ${round.round}`;
const progression = selection.rounds.flatMap(round => round.games.flatMap((game, index) => [game.fromA, game.fromB].flatMap(edge => {
  const parent = edge && games.find(parent => parent.family === game.family && parent.match === edge.match);
  return parent ? [{ from: parent.id, to: game.id, label: `${edge.outcome === 'w' ? 'Advancing side' : 'Other side'} to ${roundHeading(round)}${round.games.length > 1 ? `, game ${index + 1}` : ''}` }] : [];
})));
---
<form class="matchup-controls bracket-controls" method="get">
  <input type="hidden" name="tab" value="playoffs" />
  <div><label for="bracket-scope">Competition</label><select id="bracket-scope" name="scope">{selection.availableScopes.map(scope => <option value={scope} selected={scope === selection.scope}>{competitionLabels[scope]}</option>)}</select></div>
  <button type="submit">Show bracket</button>
</form>
{selection.rounds.length ? <>
  <nav class="bracket-round-links" aria-label="Bracket rounds">{selection.rounds.map(round => <a href={`#bracket-round-${round.round}`}>{roundHeading(round)}</a>)}</nav>
  {selection.byes.length > 0 && <p class="bracket-byes">Round 1 byes: {selection.byes.map((team, index) => <>{index > 0 && ', '}<a href={`/managers/${team.personId}/seasons/${selection.year}/?scope=playoffs`}>{team.personName}</a></>)}</p>}
  <p id="bracket-scroll-hint" class="bracket-scroll-hint" hidden>Scroll across rounds</p>
  <div class="bracket-scroll" role="region" aria-label={`${competitionLabels[selection.scope]} bracket`} tabindex="0">
    <div class="bracket-canvas" style={`width:${canvasWidth}px;height:${canvasHeight}px;grid-template-columns:repeat(${selection.rounds.length},${width}px)`}>
      <svg class="bracket-connections" width={canvasWidth} height={canvasHeight} aria-hidden="true">{connections.map(path => <path d={path} />)}</svg>
      {selection.rounds.map(round => <section id={`bracket-round-${round.round}`} class="bracket-round" aria-label={roundHeading(round)} tabindex="-1">
        <h2 class="bracket-round-heading">{roundHeading(round)}</h2>
        {round.games.map((game, index) => <article id={`bracket-${game.id}`} class="bracket-contest" aria-label={`${heading(game)}, game ${index + 1}`} tabindex="-1" style={`top:${positions.get(game.id)! * rowStep}px`}>
          <h3>{game.href ? <a href={game.href}>{heading(game)}</a> : heading(game)}</h3>
          <ol class="bracket-sides">{game.sides.map(side => <li class:list={{ 'bracket-advanced': side && game.advancingRosterId === side.rosterId }}>
            <span class="bracket-identity">{side ? <>
              {side.playoffSeed !== null && <span class="bracket-seed">{side.playoffSeed}<span class="visually-hidden"> seed</span></span>}
              <a href={`/managers/${side.personId}/seasons/${selection.year}/?scope=${selection.scope}`}>{side.personName}</a>
              {game.advancingRosterId === side.rosterId && <span class="bracket-outcome">{game.championship ? 'Champion' : 'Advanced'}</span>}
            </> : <span>Not yet determined</span>}</span>
            <span class="bracket-score">{side?.points == null ? '—' : format(side.points)}</span>
          </li>)}</ol>
          <div class="bracket-progression">{progression.filter(edge => edge.from === game.id).map(edge => <a href={`#bracket-${edge.to}`}>{edge.label}</a>)}</div>
        </article>)}
      </section>)}
    </div>
  </div>
</> : <p class="empty-history">No results for this selection.</p>}
<script>
  const bracket = document.querySelector<HTMLElement>('.bracket-scroll');
  const hint = document.querySelector<HTMLElement>('#bracket-scroll-hint');
  if (bracket && hint) new ResizeObserver(() => {
    const overflows = bracket.scrollWidth > bracket.clientWidth;
    hint.hidden = !overflows;
    if (overflows) bracket.setAttribute('aria-describedby', hint.id);
    else bracket.removeAttribute('aria-describedby');
  }).observe(bracket);
</script>
