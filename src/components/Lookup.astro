---
interface Props { username: string; autofocus?: boolean }
const { username, autofocus = false } = Astro.props;
---
<form class="lookup" method="get" action="/">
  <h1 class="painted">Find your league</h1>
  <div class="lookup-row">
    <input name="u" value={username} placeholder="Sleeper username" aria-label="Sleeper username" autocomplete="username" required autofocus={autofocus} />
    <button>Find leagues</button>
  </div>
</form>
