---
// A titled part of a page with its own link.
import ShareLink from './ShareLink.astro';
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<section class="block" id={id}>
  <h2 class="painted"><span id={`${id}-name`}>{title}</span><ShareLink label={`Share ${title}`} hash={`#${id}`} /></h2>
  <slot />
</section>
