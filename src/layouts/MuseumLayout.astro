---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/museum.css';
interface Props { title: string; section?: 'Records' | 'Managers' | 'Seasons' | 'Rivalries' }
const { title, section } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Farls da bag</title>
    <meta name="description" content="Explore the Farls da bag fantasy football league's history." />
  </head>
  <body>
    <a class="museum-skip" href="#main-content">Skip to content</a>
    <SiteHeader section={section} />
    <main class="museum-main" id="main-content" tabindex="-1">
      <slot />
      {(Astro.response.status === 404 || Astro.response.status === 503) && <nav class="recovery-navigation" aria-label="Explore the museum">
        <a href="/">Home</a>
        <a href="/records/">Records</a>
        <a href="/managers/">Managers</a>
        <a href="/seasons/">Seasons</a>
      </nav>}
    </main>
  </body>
</html>
<style>
  .recovery-navigation { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 20px; }
  .recovery-navigation a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
